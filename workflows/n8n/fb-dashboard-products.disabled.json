{
  "name": "FB Dashboard | Product Catalog to Supabase [DISABLED]",
  "nodes": [
    {
      "parameters": {
        "content": "## CONTROLLED RELEASE SAFETY\nInactive template with a closed code gate. The initial catalog run is capped at 50 pages of 100 products. Later runs use the last successful timestamp with a five-minute overlap. Requests retry three times, pagination pauses for one second, and the checkpoint advances only after all writes succeed.",
        "height": 280,
        "width": 540,
        "color": 5
      },
      "id": "products-note",
      "name": "Read Before Testing",
      "type": "n8n-nodes-base.stickyNote",
