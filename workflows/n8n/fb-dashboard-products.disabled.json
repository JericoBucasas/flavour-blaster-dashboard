    {
      "parameters": {
        "jsCode": "const b = $('Normalize Products and Variants').item.json;\nconst pagesRead = b.pagesRead + 1;\nconst hasNextPage = Boolean(b.pageInfo?.hasNextPage);\nif (hasNextPage && pagesRead >= b.maxPages) throw new Error(`SHOPIFY_PRODUCTS_PAGE_LIMIT_REACHED:${b.maxPages}`);\nif (hasNextPage && !b.pageInfo?.endCursor) throw new Error('SHOPIFY_PRODUCTS_CURSOR_MISSING');\nreturn [{ json: { start: b.start, end: b.end, query: b.query, after: hasNextPage ? b.pageInfo.endCursor : null, page: b.page + 1, maxPages: b.maxPages, pagesRead, productsRead: b.productsRead + b.products.length, variantsRead: b.variantsRead + b.variants.length, continue: hasNextPage } }];"
      },
