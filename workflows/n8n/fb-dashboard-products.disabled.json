      },
      "id": "products-read-checkpoint",
      "name": "Read Products Checkpoint [CREDENTIAL REQUIRED]",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -640,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "FB_SUPABASE_SECRET_REQUIRED",
          "name": "Flavour Blaster Supabase Secret [REQUIRED]"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst checkpoint = rows.find(r => r && r.source_key === 'shopify_products') || null;\nconst end = new Date();\nconst saved = checkpoint?.cursor_updated_at ? new Date(checkpoint.cursor_updated_at) : null;\nconst start = saved && !Number.isNaN(saved.getTime()) ? new Date(saved.getTime() - 5 * 60000).toISOString() : null;\nreturn [{ json: { start, end: end.toISOString(), query: start ? `updated_at:>=${start}` : '', after: null, page: 1, maxPages: 50, pagesRead: 0, productsRead: 0, variantsRead: 0 } }];"
      },
      "id": "products-state",
      "name": "Build Catalog Sync State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jetchill-mixology.myshopify.com/admin/api/2026-07/graphql.json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "shopifyOAuth2Api",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ query: `query DashboardProducts($query: String, $after: String) { products(first: 100, after: $after, sortKey: UPDATED_AT, query: $query) { pageInfo { hasNextPage endCursor } nodes { id legacyResourceId title handle status vendor productType tags updatedAt featuredMedia { preview { image { url } } } variants(first: 100) { nodes { id legacyResourceId title sku barcode price compareAtPrice inventoryQuantity updatedAt image { url } } } } } }`, variables: { query: $json.query || null, after: $json.after } }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "products-shopify",
      "name": "Shopify GraphQL - Products Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -160,
        20
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "shopifyOAuth2Api": {
          "id": "TOFvh8rHI1pD468B",
          "name": "Flavour Blaster OAuth2"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "products-merge",
      "name": "Merge State and Shopify Response",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        60,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $json.data?.products;\nif (!response || !response.pageInfo || !Array.isArray(response.nodes)) throw new Error('SHOPIFY_PRODUCTS_RESPONSE_INVALID');\nconst numericId = gid => Number(String(gid || '').split('/').pop()) || null;\nconst products = []; const variants = [];\nfor (const p of response.nodes) {\n  const productId = Number(p.legacyResourceId) || numericId(p.id);\n  if (!Number.isSafeInteger(productId)) throw new Error('SHOPIFY_PRODUCT_ID_INVALID');\n  products.push({ shopify_product_id: productId, title: p.title, handle: p.handle, status: String(p.status || '').toLowerCase(), vendor: p.vendor, product_type: p.productType, tags: p.tags || [], image_url: p.featuredMedia?.preview?.image?.url || null, shopify_updated_at: p.updatedAt, raw: p });\n  for (const v of p.variants?.nodes || []) { const variantId = Number(v.legacyResourceId) || numericId(v.id); if (!Number.isSafeInteger(variantId)) throw new Error('SHOPIFY_VARIANT_ID_INVALID'); variants.push({ shopify_variant_id: variantId, shopify_product_id: productId, title: v.title, sku: v.sku, barcode: v.barcode, price: Number(v.price || 0), compare_at_price: v.compareAtPrice == null ? null : Number(v.compareAtPrice), inventory_quantity: v.inventoryQuantity, image_url: v.image?.url || p.featuredMedia?.preview?.image?.url || null, shopify_updated_at: v.updatedAt, raw: v }); }\n}\nreturn [{ json: { start: $json.start, end: $json.end, query: $json.query || '', after: $json.after, page: Number($json.page), maxPages: Number($json.maxPages), pagesRead: Number($json.pagesRead || 0), productsRead: Number($json.productsRead || 0), variantsRead: Number($json.variantsRead || 0), products, variants, pageInfo: response.pageInfo } }];"
      },
      "id": "products-normalize",
      "name": "Normalize Products and Variants",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        100
      ]
    },
