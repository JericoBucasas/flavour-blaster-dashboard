        -1080,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const DEVELOPMENT_GATE = false;\nif (!DEVELOPMENT_GATE) throw new Error('DEVELOPMENT_GATE_CLOSED: approve a bounded product test before changing this value');\nreturn $input.all();"
      },
