{
  "name": "FB Dashboard | Sync Health Monitor [DISABLED]",
  "nodes": [
    {
      "parameters": {
        "content": "## READ-ONLY SYNC MONITOR\nInactive template with a closed code gate. It reads only the approved `fb_sync_state` columns. Orders must have a successful checkpoint within two hours; the daily product catalog within 26 hours; and GA4 traffic within 12 hours. No email, Sheet, Slack, Teams or other external output is connected.",
        "height": 240,
        "width": 500,
        "color": 5
      },
      "id": "health-note",
      "name": "Read Before Testing",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -620,
        -220
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "health-schedule",
      "name": "Schedule - Hourly (Inactive)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -580,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const DEVELOPMENT_GATE = false;\nif (!DEVELOPMENT_GATE) throw new Error('DEVELOPMENT_GATE_CLOSED: approve a read-only health check before changing this value');\nreturn $input.all();"
      },
      "id": "health-gate",
      "name": "Closed Development Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -340,
        100
      ]
    },
    {
      "parameters": {
        "url": "https://hnmmlfelaezmijbbwzsg.supabase.co/rest/v1/fb_sync_state?source_key=in.(shopify_orders,shopify_products,ga4_traffic)&select=source_key,cursor_updated_at,last_success_at,metadata,updated_at&order=source_key.asc",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "User-Agent",
              "value": "FlavourBlasterDashboard-n8n/1.0"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "health-read",
      "name": "Read Supabase Sync State [CREDENTIAL REQUIRED]",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "alwaysOutputData": true,
      "position": [
        -80,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpCustomAuth": {
          "id": "FB_SUPABASE_CUSTOM_REQUIRED",
          "name": "Flavour Blaster Supabase Service Role [REQUIRED]"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst byKey = new Map(rows.filter(r => r?.source_key).map(r => [r.source_key, r]));\nconst now = Date.now();\nconst required = [{ key: 'shopify_orders', maxAgeMs: 2 * 60 * 60 * 1000 }, { key: 'shopify_products', maxAgeMs: 26 * 60 * 60 * 1000 }, { key: 'ga4_traffic', maxAgeMs: 12 * 60 * 60 * 1000 }];\nconst stale = required.filter(({ key, maxAgeMs }) => { const row = byKey.get(key); const when = row?.last_success_at ? Date.parse(row.last_success_at) : NaN; return !Number.isFinite(when) || now - when > maxAgeMs; }).map(x => x.key);\nif (stale.length) throw new Error(`SYNC_HEALTH_STALE:${stale.join(',')}`);\nreturn [{ json: { status: 'healthy', checkedAt: new Date().toISOString(), sources: required.map(x => ({ source_key: x.key, last_success_at: byKey.get(x.key).last_success_at })) } }];"
      },
      "id": "health-evaluate",
      "name": "Evaluate Source Freshness",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        100
      ]
    }
  ],
  "connections": {
    "Schedule - Hourly (Inactive)": {
